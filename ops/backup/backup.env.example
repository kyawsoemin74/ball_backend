# Load these values from the approved secret manager. Never commit real values.
DATABASE_URL=postgresql://backup_user:password@db-host:5432/fover_db
BACKUP_GCS_URI=gs://approved-offsite-bucket/fover/postgresql
BACKUP_ENCRYPTION_KEY_B64=base64-key-from-secret-manager
BACKUP_LOCAL_DIR=/var/backups/fover
BACKUP_RETENTION_DAYS=30
BACKUP_STALE_HOURS=26
# Optional: BACKUP_ALERT_WEBHOOK_URL=https://secret-managed-endpoint