# Staging-only template. Load actual passwords, GCS credentials, and key from a secret manager.
DATABASE_URL=postgresql://fover_staging_user@127.0.0.1:55432/fover_staging
REDIS_URL=redis://127.0.0.1:56379/0
BACKUP_GCS_URI=gs://REPLACE_WITH_STAGING_ONLY_BUCKET/fover-staging/postgresql
# GCS is deferred for local staging drills; use the separate D: volume instead.
BACKUP_STORAGE_PATH=D:/FoverBackup
BACKUP_ENCRYPTION_KEY_B64=REPLACE_WITH_STAGING_SECRET_MANAGER_VALUE
BACKUP_LOCAL_DIR=C:/FoverStaging/backups
BACKUP_RETENTION_DAYS=30
BACKUP_STALE_HOURS=26
# Optional: BACKUP_ALERT_WEBHOOK_URL=<staging-only secret-managed endpoint>