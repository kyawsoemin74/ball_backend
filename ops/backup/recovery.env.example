# Disposable/staging recovery template. Values come from provisioning or the approved secret manager.
DATABASE_URL=<recovery-db-provisioning>
REDIS_URL=redis://127.0.0.1:6379/0
JWT_SECRET_KEY=<secret-manager: application JWT signing key>
FOOTBALL_API_KEY=<secret-manager: API-Football credential>
GOOGLE_CLIENT_ID=<secret-manager: Google OAuth client id>
NEWS_UPLOAD_DIR=<recovery-filesystem>/uploads/news
NEWS_UPLOAD_PUBLIC_URL=https://<recovery-domain>/uploads/news/
BACKUP_ENCRYPTION_KEY_B64=<secret-manager: backup encryption key>
ASSET_BACKUP_ENCRYPTION_KEY=<secret-manager: asset backup encryption key>
BACKUP_STORAGE_PATH=D:/FoverBackup
BACKUP_LOCAL_DIR=<recovery-filesystem>/backups
ENVIRONMENT=disposable-recovery
SCHEDULER_ENABLED=false