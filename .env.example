# Football API credentials
FOOTBALL_API_KEY=your_api_football_key

# Runtime security policy
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
ENABLE_API_DOCS=true
ENABLE_API_METRICS=true

# JWT signing secret, required for auth
JWT_SECRET_KEY=your_random_jwt_secret

# Google OAuth client identifier, required for Google authentication
GOOGLE_CLIENT_ID=your_google_client_id

# Legacy API key support (not required for JWT auth)
API_KEY=your_optional_api_key

# Database and cache URLs for Docker Compose
DATABASE_URL=postgresql://user:password@postgres:5432/fover_db
REDIS_URL=redis://redis:6379/0

# Background scheduler flag; set false when scheduler ownership is external
SCHEDULER_ENABLED=true

# Frozen LIVE_SYNC Run Decision policy; must remain 60 minutes.
POST_KICKOFF_MAX_WINDOW_MINUTES=60
